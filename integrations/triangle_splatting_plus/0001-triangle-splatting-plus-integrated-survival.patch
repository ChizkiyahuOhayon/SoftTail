+++ b/arguments/__init__.py
@@ -122,6 +122,10 @@ class OptimizationParams(ParamGroup):
         self.start_opacity_floor = 5000
 
         self.start_pruning = 4000
+        # Rank faces by integrated contribution sum(alpha*T) instead of the
+        # per-pixel peak when pruning, densifying and cleaning up. The peak
+        # rule still decides how many faces go; this only changes which.
+        self.integrated_importance = False
         self.sigma_until = 30000
         self.final_opacity_iter = 24000
 
